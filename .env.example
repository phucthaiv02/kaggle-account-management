# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Khóa mã hóa token Kaggle. Tạo bằng:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Mất khóa này thì không giải mã lại được các token đã lưu.
SECRET_KEY=

# Mật khẩu đăng nhập trang quản trị
ADMIN_PASSWORD=

# Tùy chọn
DB_PATH=data/kaggle_accounts.db
REFRESH_MINUTES=30
KAGGLE_CONCURRENCY=3
KAGGLE_TIMEOUT=60
# Đặt 1 khi chạy sau HTTPS
COOKIE_SECURE=0
