# Sao chép thành .env để chạy cục bộ. KHÔNG commit file .env.
# Trên Vercel: đặt các biến này trong Project Settings → Environment Variables.

# Supabase: Project Settings → API (URL của project) và API Keys
SUPABASE_URL=https://<project-ref>.supabase.co

# Khóa SECRET (sb_secret_...) hoặc khóa service_role kiểu cũ, ĐỂ Ở SERVER.
# KHÔNG dùng khóa anon/publishable (bảng đã khóa RLS nên khóa công khai không đọc được gì).
# Khóa này có toàn quyền với database: tuyệt đối không đưa vào trình duyệt hay Git.
SUPABASE_SECRET_KEY=

# Khóa mã hóa token Kaggle (Fernet). Tạo bằng:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KHÔNG BAO GIỜ đổi sau khi đã thêm tài khoản, đổi là mất khả năng giải mã token đã lưu.
SECRET_KEY=

# Mật khẩu đăng nhập trang quản trị (đổi mật khẩu sẽ đăng xuất mọi phiên)
ADMIN_PASSWORD=

# Tùy chọn
# Tổng thời gian tối đa (giây) cho một lần "Làm mới tất cả"; phải nhỏ hơn maxDuration trong vercel.json
REFRESH_BUDGET_SECONDS=50
KAGGLE_CONCURRENCY=3
KAGGLE_TIMEOUT=30
# Trang Sessions (đều tùy chọn)
# Số notebook tối đa lấy mỗi tài khoản / số cái được hỏi trạng thái / số cái được ước tính thời lượng từ log / timeout mỗi tài khoản (giây)
SESSIONS_LIMIT=30
SESSIONS_STATUS_LIMIT=20
SESSIONS_DURATION_BUDGET=3
SESSIONS_TIMEOUT=40
# Chạy cục bộ qua HTTPS thì đặt 1 (trên Vercel cookie luôn là Secure)
COOKIE_SECURE=0
